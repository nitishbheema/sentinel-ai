# SentinelAI Production Environment Configuration Template
# DO NOT COMMIT THE ACTUAL .env FILE TO VERSION CONTROL
# Generate cryptographically secure secrets before deploying to production.

# Application Environment (development / testing / production)
ENVIRONMENT=production
DEBUG=False

# JWT Secret Key (Generate with: openssl rand -hex 32)
SECRET_KEY=CHANGE_ME_GENERATE_A_SECURE_RANDOM_SECRET_MIN_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server Network Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=https://sentinel-ai.pages.dev

# Database Configuration (PostgreSQL in production)
POSTGRES_USER=CHANGE_ME_POSTGRES_USER
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_STRONG_DB_PASSWORD
POSTGRES_DB=sentinelai_db
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# In-Memory Queue & Cache (Redis)
REDIS_PASSWORD=CHANGE_ME_GENERATE_STRONG_REDIS_PASSWORD
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
REDIS_ENABLED=True

# Sensor & Endpoint Agent Authentication Secret (Generate with: openssl rand -hex 24)
AGENT_SHARED_SECRET=CHANGE_ME_AGENT_SHARED_HMAC_SECRET

# Optional: Initial Administrator Provisioning (If not set, first-time setup via UI)
# INITIAL_ADMIN_USERNAME=admin
# INITIAL_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD_MIN_12_CHARS_WITH_SYMBOLS
# INITIAL_ADMIN_EMAIL=admin@yourdomain.com

# Machine Learning Paths
MODEL_DIR=../ml-engine/models
DATASET_DIR=../ml-engine/datasets

# Risk Engine Threshold Weights (Must sum to 1.0)
RISK_WEIGHT_ML=0.35
RISK_WEIGHT_RULE=0.30
RISK_WEIGHT_CORRELATION=0.20
RISK_WEIGHT_THREAT_INTEL=0.15
