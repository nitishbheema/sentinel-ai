# SentinelAI Environment Configuration

# Application
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=sentinelai_super_secret_jwt_key_change_in_production_min32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database (PostgreSQL with SQLite fallback for offline lab tests)
DATABASE_URL=sqlite:///./sentinelai.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql://sentinel_user:sentinel_password@localhost:5432/sentinelai_db

# Background Processing & Cache (Redis)
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=False

# Machine Learning
MODEL_DIR=../ml-engine/models
DATASET_DIR=../ml-engine/datasets

# Risk Engine Thresholds
RISK_WEIGHT_ML=0.35
RISK_WEIGHT_RULE=0.30
RISK_WEIGHT_CORRELATION=0.20
RISK_WEIGHT_THREAT_INTEL=0.15

# Agent Authentication
AGENT_SHARED_SECRET=sentinel_agent_telemetry_secure_key_2026
